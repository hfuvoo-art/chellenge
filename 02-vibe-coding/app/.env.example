# Скопируйте в .env на сервере. Файл .env не коммитится.
# Домен сайта (A-запись на IP сервера). Без домена: <IP>.sslip.io
DOMAIN=dekanat.example.ru

# Необязательно: ИИ для ответов помощника (YandexGPT через OpenAI-совместимый API).
# Без этих строк помощник отвечает шаблонами по тем же положениям.
LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
LLM_API_KEY=
LLM_PROJECT=
LLM_MODEL=
