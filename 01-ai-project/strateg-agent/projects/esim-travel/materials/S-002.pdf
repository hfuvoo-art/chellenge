   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Buildings in Rosa Plateau mountain village. Rose Plateau and Roza Khutor are alpine ski resorts near Krasnaya Polyana town in Sochi region, Russia.</rdf:li>
    </rdf:Alt>
   </dc:description>
