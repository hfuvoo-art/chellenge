   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Illuminated high-rise stalinist building near river at summer night in Moscow, Russia. Historic name is Hotel Ukraina. Translation of the inscription on the facade: Ukraine</rdf:li>
    </rdf:Alt>
   </dc:description>
