   <dc:creator>
    <rdf:Seq>
     <rdf:li>Marinodenisenko</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Jacaranda (Jacaranda mimosifolia) trees in fountain 'Infinity' in form of huge bowl with granite steps on Stadium Krasnodar background. Public landscape park 'Krasnodar' or 'Galitsky park'</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:title>
