   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Winter aerial view of the Ski Resort Rosa Khutor. A complex of hotels on the site of the former Olympic village of Rosa Plateau at an altitude of 1170 m from sea level. Krasnaya Polyana, Sochi, Russia</rdf:li>
    </rdf:Alt>
   </dc:description>
