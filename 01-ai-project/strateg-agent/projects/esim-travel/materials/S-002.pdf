   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Beautiful spring mountains blooming pink maralnik wild rosemary. Chuysky tract Altai, Siberia, Russia, Drone aerial view.</rdf:li>
    </rdf:Alt>
