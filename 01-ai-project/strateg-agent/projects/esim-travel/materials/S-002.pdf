   <dc:creator>
    <rdf:Seq>
     <rdf:li>saiko3p</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Gelendzhik city cape aerial panoramic view. Gelendzhik is a resort town located on the Gelenjik Bay of the Black Sea in Krasnodar Krai, Russia.</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">2427242227</rdf:li>
    </rdf:Alt>
   </dc:title>
