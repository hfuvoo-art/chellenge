   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Autumn landscape with beautiful yellowed trees on the banks of calm river and a mountain range at sunny day. Siberia, Baikal region, Eastern Sayan, Buryatia, Tunka foothill valley, Irkut river</rdf:li>
    </rdf:Alt>
   </dc:description>
