   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Argun Gorge, Chechen Republic (Chechnya), Russia. Top view of the Argun River flowing in a gorge among the rocks. Summer landscape with a mountain river. Natural landmark. Travel in the North Caucasus</rdf:li>
    </rdf:Alt>
   </dc:description>
