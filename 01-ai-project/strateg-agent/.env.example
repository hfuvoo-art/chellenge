# Шаблон настроек. Скопируйте в .env и заполните; сам .env в git не попадает.
# Ключи и токены сюда вписывает только пользователь, в код и журналы они не попадают.

# --- Модель (задача 2). Значения вписывает пользователь; пустое = не задано. ---
# Общее подключение к OpenAI-совместимому API (Yandex AI Studio): адрес, ключ, folder_id (уходит в заголовок OpenAI-Project).
# Для Yandex AI Studio: https://llm.api.cloud.yandex.net/v1 (LLM_PROJECT = ID каталога).
LLM_BASE_URL=
# Таймаут одного запроса, с (по умолчанию 180: длинные части обрабатываются до ~70 с).
LLM_TIMEOUT_S=
LLM_API_KEY=
LLM_PROJECT=
# Модели по ролям, формат Yandex: gpt://<folder_id>/<модель> (каталог: https://aistudio.yandex.ru/docs/ru/ai-studio/concepts/generation/models).
# Рекомендуем: EXTRACT_MODEL=gpt://<folder_id>/aliceai-llm-flash, PRO_MODEL=gpt://<folder_id>/yandexgpt-5.1.
# YandexGPT Lite 5 (yandexgpt-5-lite) отключается 15.11.2026 — не используйте. Как получить ключ и ID каталога — README, раздел «Как получить ключ Yandex AI Studio».
EXTRACT_MODEL=
PRO_MODEL=
JUDGE_MODEL=
# Критик: своя модель, при необходимости свой доступ (иначе берутся LLM_*).
CRITIC_MODEL=
CRITIC_BASE_URL=
CRITIC_API_KEY=
CRITIC_PROJECT=
# Маршрут среды: claude-code | opencode | cursor | other (пусто: при CLAUDECODE=1 claude-code, иначе other).
AGENT_ROUTE=
# Семейства моделей для проверки независимости критика (для Claude Code: claude и yandexgpt;
# для OpenCode на YandexGPT критик другого семейства — gpt://<folder_id>/qwen3.6-35b-a3b, семейство qwen).
MAIN_MODEL_FAMILY=
CRITIC_MODEL_FAMILY=
